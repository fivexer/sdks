# Line endings are a contract, not a preference.
#
# `contract/operations.yaml` is parsed by every SDK's ContractParityTest with a line-anchored
# regex. PCRE and Python both take `$` in multiline mode to mean "before \n" — with CRLF the
# character before \n is \r, so the anchor never matches and the catalogue parses as ZERO
# operations. The PHP suite caught exactly that on the Windows runners; the "expected the full
# catalogue" guard is what turned a silently-vacuous pass into a visible failure.
#
# Normalising to LF in the working tree on every platform removes the whole class of problem,
# rather than teaching each parser to tolerate a checkout setting.
* text=auto eol=lf

# Windows batch files are the exception that genuinely needs CRLF: cmd.exe mis-parses a
# LF-only .bat, and gradlew.bat is on the Java CI path.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch these — normalisation would corrupt them.
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# What `composer require fivexer/sdk` actually downloads.
#
# The PHP package's manifest is this repo's root composer.json (Packagist reads no other
# location), which means the dist archive would otherwise carry the Python, Java and tooling
# trees to every PHP consumer. Only src/, the manifest, the licence and the README need to
# travel; the tests stay in git — they are the specification — but nobody vendoring the SDK
# needs them in their tree.
/python          export-ignore
/java            export-ignore
/contract        export-ignore
/scripts         export-ignore
/.github         export-ignore
/php/tests       export-ignore
/php/bin         export-ignore
/php/build       export-ignore
/php/phpunit.xml export-ignore
/php/Dockerfile.dev export-ignore
/.gitattributes  export-ignore
/.gitignore      export-ignore
/examples/java       export-ignore
/examples/python     export-ignore
/examples/typescript export-ignore
