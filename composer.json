{
    "name": "fivexer/sdk",
    "description": "Typed PHP client for the Fivexer Platform /v1 routing API",
    "type": "library",
    "license": "MIT",
    "keywords": ["fivexer", "routing", "task-routing", "assignment", "taskrouter", "redis"],
    "homepage": "https://github.com/fivexer/sdks",
    "authors": [
        {
            "name": "Fivexer"
        }
    ],
    "support": {
        "issues": "https://github.com/fivexer/sdks/issues",
        "source": "https://github.com/fivexer/sdks/tree/main/php",
        "docs": "https://5xer.com/docs"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpunit/php-invoker": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Fivexer\\SDK\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fivexer\\SDK\\Tests\\": "php/tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": true,
        "vendor-dir": "php/vendor"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
